# Пример переменных окружения для docker-compose.
# Скопируйте файл в .env и заполните значения под своё окружение:
#   cp .env.example .env

# --- Приложение ---
# Включает подробный вывод ошибок (never set to true in production!)
APP_DEBUG=false
# Ключ доступа к нашему API (заголовок X-API-KEY)
APP_API_KEY=change-me

# --- Внешний API Checko ---
CHECKO_API_KEY=demo-key
CHECKO_BASE_URL=https://api.checko.ru/v2
# Использовать mock-данные вместо реальных запросов к Checko
CHECKO_USE_MOCK=true

# --- PostgreSQL ---
DB_HOST=postgresql
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASS=secret
