{
    "name": "app/vanilla-php",
    "description": "Базовый проект на Vanilla PHP 8.2+ с Composer, PSR-4 автозагрузкой и Docker Compose (php + postgresql)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "zircote/swagger-php": "^4.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "init": [
            "@composer dump-autoload --optimize"
        ],
        "swagger": [
            "vendor/bin/openapi src -o public/docs/openapi.yaml"
        ]
    }
}
